#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
	keymap {
		compatible = "zmk,keymap";

		/*
		 * 스위치 순서: 0=상  1=하  2=좌  3=우  4=발사  5=Fn
		 */

		base_layer {
			display-name = "Play";
			bindings = <
				&kp UP
				&kp DOWN
				&kp LEFT
				&kp RIGHT
				&kp SPACE
				&mo 1
			>;
		};

		/*
		 * Fn을 누른 상태에서만 활성화.
		 *
		 *   Fn + 상    안드로이드 폰      (프로필 0)
		 *   Fn + 하    안드로이드 태블릿  (프로필 1)
		 *   Fn + 좌    윈도우 PC          (프로필 2)
		 *   Fn + 우    USB / 블루투스 출력 전환
		 *   Fn + 발사  현재 프로필 페어링 삭제
		 */
		settings_layer {
			display-name = "BT";
			bindings = <
				&bt BT_SEL 0
				&bt BT_SEL 1
				&bt BT_SEL 2
				&out OUT_TOG
				&bt BT_CLR
				&trans
			>;
		};
	};
};
